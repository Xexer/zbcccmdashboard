{
  "_version": "1.83.1",
  "sap.app": {
    "id": "rewe.bc.zbcccmdashboard",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.27.0",
      "toolsId": "2bf3bb7c-21d8-4a62-93af-7619c5b53e2f"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zbc_ui_ccm_dashboard_o4/srvd/sap/zbc_ccm_dashboard/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.145.3",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "rewe.bc.zbcccmdashboard.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "DashboardList",
          "target": "DashboardList"
        },
        {
          "pattern": "Dashboard({key}):?query:",
          "name": "DashboardObjectPage",
          "target": "DashboardObjectPage"
        },
        {
          "pattern": "Dashboard({key})/_OtherScores({key2}):?query:",
          "name": "ScoresObjectPage",
          "target": "ScoresObjectPage"
        }
      ],
      "targets": {
        "DashboardList": {
          "type": "Component",
          "id": "DashboardList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Dashboard",
              "variantManagement": "Page",
              "navigation": {
                "Dashboard": {
                  "detail": {
                    "route": "DashboardObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "DashboardObjectPage": {
          "type": "Component",
          "id": "DashboardObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Dashboard",
              "navigation": {
                "_OtherScores": {
                  "detail": {
                    "route": "ScoresObjectPage"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "ChartINtegration": {
                      "template": "rewe.bc.zbcccmdashboard.ext.fragment.ChartIntegration",
                      "position": {
                        "placement": "After",
                        "anchor": "idNumbers"
                      },
                      "title": "{i18n>trend}"
                    }
                  }
                }
              }
            }
          }
        },
        "ScoresObjectPage": {
          "type": "Component",
          "id": "ScoresObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Dashboard/_OtherScores"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
